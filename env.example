# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp env.example .env

# --- LLM moderation (OpenAI-compatible API) ---
# Required to enable the hourly adult/spam removal pass. Without it the pass
# stays off and the static keyword filter still runs.
OPENAI_API_KEY=

# OpenRouter with a free (:free) model is the default provider. Free models
# cost nothing but are rate-limited per account: 20 req/min, and 1000 req/day
# only if the account has ever bought >= $10 of credits (50/day otherwise).
# In OpenRouter settings, the privacy/data policy must allow free endpoints
# (prompts may be used for training) or requests fail with "no endpoints".
# Any OpenAI-compatible endpoint works:
#   DeepSeek     https://api.deepseek.com/v1      + OPENAI_MODEL=deepseek-v4-flash
#   OpenAI       https://api.openai.com/v1        + OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

MODERATION_ENABLED=true
MODERATION_INTERVAL=1h
# Per-attempt timeout; requests retry at most 3 times. Increase for slow providers.
MODERATION_TIMEOUT=2m
# 100 titles per request keeps throughput at 2000 titles/hour while halving
# request count vs 50x40: 20 x 24 = 480 req/day, well under OpenRouter's
# 1000 req/day free-model cap (which counts retries and any other free-model
# use on the account).
MODERATION_BATCH_SIZE=100
# Batches per pass; caps hourly spend. 20 x 100 = 2000 titles/hour. 0 = unlimited.
MODERATION_MAX_BATCHES=20
# Set true to log what would be deleted without deleting anything.
MODERATION_DRY_RUN=false
# Strip site banners, promo URLs and uploader ad tags from titles during the
# same hourly pass — one LLM call does both, so this costs only output tokens.
# The raw title is kept and stays searchable; only the displayed name changes.
MODERATION_TRIM_TITLES=true

# --- Crawling ---
# Master switch for the DHT crawler. Off = API/web only (plus feeds and
# trending if enabled); pair with --seed-demo for a demo instance.
# CRAWL_ENABLED=true
# DHT UDP listen port (0 = random). With DHT_IDENTITIES > 1 the extra
# identities take DHT_PORT+1, +2, ... (see DHT_IDENTITIES below).
# DHT_PORT=0
# Fetch metadata (BEP 9) for discovered hashes. Off = collect infohashes
# only, nothing is indexed.
# FETCH_METADATA=true
# The tuning knobs below interact. Numbers are measured on a 2 vCPU / 4 GB
# VPS; re-measure with /api/stats before changing them on different hardware.
#
# Concurrent BEP 51 sampling workers. Discovery is NOT the bottleneck once
# sampling works at all — 8 samplers already find ~3000 infohashes/min, ~20x
# more than the fetch pool can consume. Raising this steals bandwidth from
# metadata fetching and lowers the indexing rate: 32 samplers measured 25/min
# indexed, 8 measured 33/min.
DHT_SAMPLERS=8
# DHT node identities in one process. Each identity is a full DHT server with
# its own random node ID, routing table and node-quality tracking; a single
# identity only samples the neighbourhood of its own table, so more
# identities widen BEP 51 coverage of the ID space. Identity i listens on
# DHT_PORT+i (with DHT_PORT=0 each identity takes a random port) — keep the
# ports DHT_PORT..DHT_PORT+DHT_IDENTITIES-1 free. DHT_SAMPLERS applies per
# identity, so total sampling workers = DHT_SAMPLERS x DHT_IDENTITIES.
# DHT_IDENTITIES=1
# IPv6 DHT (BEP 32): each identity also runs an IPv6 DHT server on the same
# port number (separate udp6 socket, same node ID), so IPv6-only swarms are
# discoverable and IPv6 peer hints feed metadata fetching like IPv4 ones.
# Hosts without usable IPv6 degrade to IPv4-only with one log line; this
# never fails startup. Set to false to run IPv4 only.
# DHT_IPV6_ENABLED=true
# Metadata fetch workers. This is the real throughput knob, since most fetches
# end in a timeout holding their slot for the full META_TIMEOUT.
# 64 -> 20/min indexed, 128 -> 33/min, 256 -> 27/min (contention wins).
META_WORKERS=128
# Torrent client shards for the fetch pool. anacrolix serializes nearly
# everything through one lock per client; at 128 workers on one client the
# lock itself became the bottleneck (ingest collapsed to ~1/5 of baseline
# with 100+ goroutines queued on it). Hashes are routed to shards by first
# byte, so 8 shards leave ~16 concurrent torrents per lock.
# META_SHARDS=8
# Metadata fetch foundation for the main pipeline: anacrolix (default,
# torrent clients as above) or native — a purpose-built thin BEP 9
# fetcher that only announces to the trackers below, connects to peers
# (TCP + uTP) and pulls the metadata pieces itself. No torrent client,
# no global lock: a stuck peer costs only its own goroutine. Both
# foundations report identical fetched/timed-out/failed/prescreen
# counters, so flip + restart + compare the pipeline: log lines to A/B.
# The feeds fetcher always stays on anacrolix. Restart to switch.
# Third option: libtorrent — libtorrent-rasterbar 2.x in a sidecar
# process (dhtsearch-lt-sidecar) that the server spawns and
# supervises; metadata-only (upload_mode, DHT off in the sidecar,
# same magnet tracker supply). The sidecar ships as an optional
# release asset and install.sh places it next to dhtsearch-server.
# Selecting libtorrent without a working sidecar fails startup
# loudly — there is no silent fallback.
# META_FETCHER=anacrolix
# Explicit sidecar path for META_FETCHER=libtorrent. Empty = look
# next to the server binary, then in PATH.
# META_LT_SIDECAR=
# Do NOT shorten this to "free up slots faster" — it backfires badly. Finding
# peers for a fresh infohash is most of the wait, so successful fetches are
# slow ones: at 20s the success rate collapsed from 20% to 0.35% and indexing
# fell to 2.4/min.
# META_TIMEOUT=45s
# Prescreen: a fetch first spends up to META_PRESCREEN_TIMEOUT waiting for
# ANY peer connection; if none shows up, the hash is abandoned then instead
# of holding the slot for the full META_TIMEOUT. The window is inside the
# META_TIMEOUT budget, not added to it — a hash whose peer connects keeps
# the full remaining budget, so live swarms are unaffected.
# META_PRESCREEN_ENABLED=true
# META_PRESCREEN_TIMEOUT=10s
# Priority queue: discovered hashes wait in a queue ranked by seeder count
# (from the scrape below), then source, then freshness, instead of a plain
# FIFO channel. Only relevant with FETCH_METADATA on.
# META_PRIORITY_ENABLED=true
# Fetch admission negative cache: before a hash takes a queue slot, the
# gate checks whether it is already indexed (skip — re-fetching it would
# change nothing) or in failure backoff (skip until the backoff expires).
# Backoff doubles per consecutive failure, 1h -> 2h -> 4h ..., capped by
# META_NEG_CACHE_MAX_BACKOFF_H; one success clears it. A scrape that just
# reported seeders and feed hashes bypass the backoff (never the
# already-indexed skip). Both knobs apply live from the settings page.
# META_NEG_CACHE_ENABLED=true
# META_NEG_CACHE_MAX_BACKOFF_H=24
# Stall watchdog: if discovery keeps moving but nothing is stored for
# 15 minutes, the process logs an ERROR plus a full goroutine dump;
# at 30 minutes it dumps again and exits so systemd restarts it (the
# unit ships Restart=on-failure). If discovery is frozen too (network
# outage shape) it only warns. A one-line pipeline summary is logged
# every 10 minutes either way.
# CRAWLER_WATCHDOG_ENABLED=true

# --- Stall alerts ---
# External notification for the watchdog's episodes: when ingest
# stalls (or crawls, or the whole pipeline freezes) for
# ALERT_STALL_MINUTES, one alert goes out on every configured
# channel; one more when ingest recovers. No repeats within an
# episode. If the watchdog escalates to a self-heal exit (at twice
# the stall minutes), the pending alert is flushed and an exit
# notice is sent synchronously before the process dies. Channels:
# a generic webhook (POST JSON {title, text, ts}) and/or Telegram
# (Bot API sendMessage; token AND chat id must both be set).
# ALERT_ENABLED itself and the channel knobs apply live from the
# settings page's 告警通知 group; ALERT_STALL_MINUTES is assembled
# into the watchdog at startup, so it needs a restart. Verify a
# configuration with POST /api/admin/alerts/test. Off by default.
# ALERT_ENABLED=false
# ALERT_WEBHOOK_URL=
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_STALL_MINUTES=15

# --- Data retention ---
# Periodic cleanup of provably-dead torrents: a torrent is deleted
# only when its swarm health derives to likely_dead (zero seeders
# AND zero leechers across at least 3 consecutive tracker scrapes
# spanning at least 48 hours) and it was indexed more than
# RETENTION_MIN_AGE_DAYS ago. The torrents row (files blob
# included), its swarm snapshot and its fetch backoff row go
# together; the blocked table is never touched. Deletion is
# irreversible, so the runner is OFF by default — the settings
# page's 数据保留 group shows the currently-eligible count before
# you enable it, and a manual one-off pass is available there too.
# All three knobs apply live from the settings page.
# RETENTION_ENABLED=false
# RETENTION_MIN_AGE_DAYS=30
# RETENTION_INTERVAL_H=24

# --- Tracker scrape ranking ---
# Discovery finds ~20x more infohashes than the fetch pool can consume, so
# WHICH hashes get a fetch slot decides what the index grows into. When
# enabled, every discovered hash is scraped against the trackers below
# (BEP 15: seeder counts for ~70 hashes per UDP packet) and the fetch queue
# is ordered by seeder count — popular content first — instead of dropping
# the overflow at random. Zero-seeder hashes are only deprioritized, not
# discarded. Watch /api/stats "scraper": seeded/scraped is the hit rate;
# evicted is what used to be silent random drops.
SCRAPE_ENABLED=true
# Periodic re-scrape of torrents already in the index: their swarm snapshot
# is otherwise written once at ingest and never refreshed, so seeder sorting
# and the five-level health derivation run on ever-staler data — and the
# retention cleanup can never prove a torrent dead (likely_dead needs >=3
# all-zero rounds spanning >=48h). Every minute the runner re-scrapes the
# stalest snapshots (never-scraped first) through the same tracker merge and
# write path as ingest. Tracker-only: never a metadata fetch, and a round is
# skipped wholesale while the metadata fetch queue is full.
RESCRAPE_ENABLED=true
# Snapshots younger than this are not re-scraped. Never-scraped torrents are
# always eligible.
RESCRAPE_MIN_AGE_H=48
# Rate cap: hashes re-scraped per minute, one round per minute.
RESCRAPE_PER_MIN=60
# Comma-separated announce URLs. Also appended to fetch magnets as &tr= peer
# hints, which shortcuts the DHT peer walk that eats most of META_TIMEOUT.
# Only udp:// entries can be scraped; keep those to the big open trackers
# that are built for this volume — the defaults include the ones US/KR/JP
# TV (美剧/韩剧/日剧, EZTV etc.) releases announce to. http(s):// entries
# are peer-hint-only — the defaults include the ACG trackers Chinese
# fansub (字幕组) releases announce to (Nyaa, AcgnX), which is what gets
# those swarms fetched. The tail of the list covers 日剧字幕组 releases:
# 动漫花园's own tracker (104.143.10.61) plus what its 日剧 section and
# Nyaa live-action uploads list.
# TRACKERS=udp://tracker.opentrackr.org:1337/announce,udp://open.demonii.com:1337/announce,udp://tracker.torrent.eu.org:451/announce,udp://exodus.desync.com:6969/announce,udp://open.stealth.si:80/announce,udp://tracker.dler.org:6969/announce,udp://tracker.qu.ax:6969/announce,udp://tracker-udp.gbitt.info:80/announce,http://nyaa.tracker.wf:7777/announce,http://t.nyaatracker.com/announce,http://opentracker.acgnx.se/announce,udp://104.143.10.61:8000/announce,udp://t.overflow.biz:6969/announce,udp://tracker.skynetcloud.site:6969/announce,http://tracker1.itzmx.com:8080/announce,http://tracker.renfei.net:8080/announce

# --- Douban trending (homepage quick-search chips) ---
# Hourly fetch of Douban's trending charts: 欧美 movies and 美剧 resolved
# to their English names via one extra subject_abstract call per
# newly-charted title (cached by subject ID); 日剧 and 韩剧 keep their
# Chinese chart titles, which match through the RSS-feed aliases below
# (their torrent names are mostly romaji).
# On failure the last good list keeps serving; if it never succeeds the
# homepage just hides the section.
# TRENDING_ENABLED=true
# TRENDING_INTERVAL=1h
# TRENDING_LIMIT=10

# --- Publisher RSS feeds ---
# Polled every FEEDS_INTERVAL: each item's infohash is fetched by a
# dedicated fetcher (FEEDS_WORKERS / FEEDS_META_TIMEOUT), apart from the
# DHT backlog (DHT sampling rarely lands on a given fansub pack), and its
# title — dmhy's carries the Chinese and Japanese names — is stored as the
# torrent's alias, which search matches. Defaults: dmhy 日剧 + Nyaa live
# action. FEEDS_KEYWORD_URL (one %s) is also searched with every trending
# 日剧/韩剧 chip title, reaching releases older than the feeds go back.
# Unfetchable hashes are retried every 6h, at most 3 times.
# FEEDS_ENABLED=true
# FEEDS=https://share.dmhy.org/topics/rss/sort_id/6/rss.xml,https://nyaa.si/?page=rss&c=4_0
# FEEDS_KEYWORD_URL=https://share.dmhy.org/topics/rss/rss.xml?keyword=%s
# FEEDS_INTERVAL=30m
# FEEDS_WORKERS=16
# FEEDS_META_TIMEOUT=90s

# --- Indexing ---
# Skip torrents whose total size is below this many bytes (default 100 MiB).
MIN_TORRENT_SIZE=104857600

# --- Appearance & admin settings page ---
# Most runtime configuration can also be changed in the admin settings
# page (/admin/settings); values saved there are stored in the database
# and take priority over these env values (database > env > default).
# The appearance settings' env layer:
# SITE_NAME=DHTSearch        # shown in page titles, headers, OG defaults
# THEME_COLOR=teal           # teal|blue|violet|green|orange|red
# THEME_APPEARANCE=system    # system|light|dark default for new visitors
# Comma-separated block words: torrents whose name or any file path
# contains one are dropped before insert (counted separately from
# the structural spam rules).
# FILTER_BLOCK_WORDS=
# Comma-separated additions to the built-in adult keyword list, and
# bare domains to block as adult signals (subdomains included).
# FILTER_ADULT_WORDS=
# FILTER_BLOCK_DOMAINS=

# --- Content filter (also editable live in /admin/settings) ---
# Master switch for the whole ingest filter; when off, nothing is
# rejected by the filter at all.
# FILTER_ENABLED=true
# Per-category switches. Turning a category off lets its torrents in
# and stops that category's counter (history is kept).
# FILTER_ADULT_ENABLED=true     # built-in adult word/domain lists
# FILTER_SPAM_ENABLED=true      # structural spam rules + block words
# FILTER_TOO_SMALL_ENABLED=true # the MIN_TORRENT_SIZE floor above
# Spam-rule thresholds (defaults shown):
# FILTER_MAX_NAME_LEN=300           # names longer than this are spam
# FILTER_STUFFING_MIN_REPEAT=4      # same word repeated >= N times
# FILTER_NON_ALNUM_MAX_RATIO=0.5    # symbol share of the name
# FILTER_RANDOM_FILE_MAX_RATIO=0.3  # random-looking file name share
# Comma-separated exception phrases: a title containing one is exempt
# from the adult lists (never from block words or spam rules), e.g.
# FILTER_ALLOW_WORDS=sex education
# FILTER_ALLOW_WORDS=

# --- Admin console ---
# ADMIN_TOKEN is the console's recovery credential. Leave it empty and
# the admin API stays disabled (every admin route answers 503 and the
# /admin UI shows a "not enabled" notice) until at least one admin
# account exists or a federated login below is configured. Use a long
# random value, e.g.
#   openssl rand -hex 32
# The token is read from the environment only: it is never stored in the
# database and never written to logs. It always works as a fallback
# login, so keep it set even after you create admin accounts — it is
# the way back in when an account or an identity provider breaks.
# Login attempts against the admin API are rate-limited separately
# (6/min per client).
# ADMIN_TOKEN=
#
# Admin accounts (username + bcrypt password, roles admin/reviewer)
# are managed in the console itself under /admin/users — no env needed.
# The two federated logins below can equally be configured in the admin
# settings page (登录与账号 group; database values win over env).
#
# GitHub login (OAuth2). Create an OAuth App at
# https://github.com/settings/developers and set its Authorization
# callback URL to <your site origin>/api/auth/github/callback — the
# settings page shows the exact URL for your deployment. Only GitHub
# usernames on the allowlist get in, even after a successful OAuth.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_USERS=your-github-name
#
# SSO via OpenID Connect (OIDC only — SAML is not supported). Register
# a client with your IdP and give it the redirect URI
# <your site origin>/api/auth/oidc/callback. Login is fail-closed:
# with neither an allowed email nor an allowed domain set, every SSO
# login is rejected.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=SSO
# OIDC_ALLOWED_EMAILS=you@example.com
# OIDC_ALLOWED_DOMAIN=example.com

# --- Server ---
# Path of the .env file to load (default .env, relative to the process
# working directory). This one must be a real environment variable —
# it names the file, so setting it inside the file itself has no effect.
# Real environment variables always win over values in the file.
# ENV_FILE=.env
# Listen address. On machines installed via scripts/install.sh this
# lives in /etc/dhtsearch/dhtsearch.env; use `install.sh install
# --api-port <port>` (or the dhtsearch menu's 修改端口) to change the
# port — the web service's API_BASE is regenerated to match.
# HTTP_ADDR=:8080
# DB_PATH=./dhtsearch.db
# Optional Postgres instead of SQLite: set a postgres:// (or postgresql://)
# connection URL and DB_PATH is ignored. Tables/indexes are created on
# startup; pg_trgm trigram indexes are added best-effort when the role may
# create extensions. Never commit a real password here.
# One-click installs choose the backend with `install.sh install --db
# sqlite|postgres-local|postgres-url` (postgres-local installs and
# configures a local PostgreSQL, generates the password and writes
# DATABASE_URL for you); the dhtsearch menu's database switch moves an
# installed system later. To move the data itself, use the server
# binary's migrate subcommand (either direction; rows already in the
# target are skipped, never overwritten):
#   dhtsearch-server migrate --from ./dhtsearch.db --to postgres://...
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/dhtsearch?sslmode=disable

# --- Auto-update (installer feature, NOT a server env setting) ---
# Scheduled automatic upgrades are managed by scripts/install.sh, not
# by this file: `dhtsearch` menu -> 自动更新, or
#   install.sh auto-update on [daily|weekly] | off | status
# It installs a systemd timer (dhtsearch-update.timer) that runs the
# normal `upgrade --yes` flow (backup + health check + rollback). The
# enabled flag, frequency and last-check result live in the installer's
# own state file /var/lib/dhtsearch/autoupdate, next to the database.

# --- API DoS defenses ---
# Sustained requests/second allowed per client IP (token bucket, with
# RATE_LIMIT_BURST of headroom). The real client is taken from
# X-Forwarded-For only when the request comes from loopback/private
# addresses (the reverse proxy or the Next.js SSR process); public peers
# cannot spoof it. 0 disables rate limiting.
# RATE_LIMIT_RPS=3
# RATE_LIMIT_BURST=30
# Concurrent search queries before requests are shed with 503. SQLite
# serializes queries on one connection anyway; this bounds the queue.
# SEARCH_MAX_INFLIGHT=16
# Database time budget per search request.
# SEARCH_TIMEOUT=10s

# --- Public API tokens ---
# The public endpoints (/api/search, /api/stats, /api/trending) are
# anonymous by default. Operators can issue per-client tokens in the
# admin console (/admin/api-tokens) and optionally require them.
# All three are also editable live on the settings page (group
# 「公开 API」); env values are just the starting layer.
# Master switch: off answers the public endpoints with 503 for
# everyone (the built-in frontend included). /api/healthz and the
# admin API are never gated.
# PUBLIC_API_ENABLED=true
# On: requests must carry a token (Authorization: Bearer or
# X-API-Key header) — missing/invalid 401, disabled 403, over the
# token's own quota 429. The built-in frontend is exempt through the
# first-party channel below, so requiring tokens no longer blocks the
# site itself. Off: endpoints stay anonymous, but requests presenting
# a valid token are counted.
# PUBLIC_API_REQUIRE_TOKEN=false
# First-party channel: the web frontend presents this secret to the
# API in the X-Internal-Token header so PUBLIC_API_REQUIRE_TOKEN does
# not lock the site itself out. The SAME value must be set on both
# services (the API reads it here; the web process needs it in its own
# environment). install.sh generates one random value into
# /etc/dhtsearch/dhtsearch.env and the web systemd unit automatically.
# Like ADMIN_TOKEN it is environment-only: never stored in the
# database, never listed with the managed API tokens, never logged.
# INTERNAL_API_TOKEN=
# Default per-minute quota stamped on newly created tokens
# (editable per token afterwards; 0 = unlimited). The per-IP bucket
# above keeps applying on top of the token quota.
# PUBLIC_API_TOKEN_RATE_PER_MIN=600

# ---------------------------------------------------------------------------
# Crawler worker nodes (multi-machine: workers fetch, one center stores)
# ---------------------------------------------------------------------------
# CENTER side: accept pushes from crawler worker nodes. The same two
# knobs live in the settings page's 节点接入 group (hot-applied);
# NODE_TOKEN is the shared secret every worker presents as a bearer
# token. Default off — an ingest surface is a deliberate opt-in.
# NODE_INGEST_ENABLED=false
# NODE_TOKEN=
# WORKER side: setting CENTER_URL turns this process into a worker
# node — it crawls, scrapes and fetches as usual, but fetched records
# are pushed to the center instead of being filtered/stored locally,
# and retention/re-scrape stay off. Worker configuration is PURE
# ENVIRONMENT on purpose (never the settings DB): a worker's database
# is its own local one. NODE_TOKEN above doubles as the worker's
# credential — set the same value here. Undelivered batches spill
# from the in-memory buffer to a disk spool in <data dir>/spool/
# and are replayed when the center answers again (they also
# survive worker restarts). The spool is capped; past the cap the
# oldest spooled batches are dropped (counted as node_dropped).
# NODE_SPOOL_MAX_MB=1024 (total spool cap in MiB; 0 = no spool,
# memory buffer only)
# CENTER_URL=https://center.example:10800
# NODE_NAME= (default: this machine's hostname)

# ---------------------------------------------------------------------------
# System update (admin panel → installer contract)
# ---------------------------------------------------------------------------
# The admin panel's 系统更新 settings. These two only seed the panel's
# intent: saving them in the panel syncs them to a state file in the
# data dir (update-panel), and the root-side upgrade agent installed
# by install.sh (a per-minute systemd timer) applies them — arming
# the auto-update timer at this time, or standing it down. The API
# process itself never executes an upgrade. Until an admin saves the
# keys in the panel at least once, the script's own CLI state
# (`dhtsearch auto-update`) rules instead.
# AUTO_UPDATE_ENABLED=false
# AUTO_UPDATE_TIME=03:37
